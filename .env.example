# Copy to .env. Values here are safe development defaults, not production credentials.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATA_ROOT=.data
# Empty uses SQLite inside DATA_ROOT. PostgreSQL configuration exists but is not verified.
DATABASE_URL=
ENABLE_PASSWORD_AUTH=true
RUN_WORKER=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# local: explicit, deterministic local extraction; responses: external AI integration.
AI_PROVIDER=local
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_DAILY_REQUEST_LIMIT=100
SESSION_DAYS=7
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_WORKSPACE_BYTES=2147483648
