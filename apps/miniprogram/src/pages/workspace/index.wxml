<view class="page"><view class="kicker">WORKSPACE / 工作空间</view><view class="title">每件事，都有它的位置。</view><view class="subtitle">一个文件，一个工作单元。任务和笔记放在一起。</view>
  <view class="buttons"><button bindtap="newFolder" disabled="{{busy}}">新建文件夹</button><button class="primary" bindtap="newGroup" disabled="{{busy}}">新建任务组</button></view>
  <view class="row section"><button class="link" bindtap="root">工作空间 / {{currentFolder.path || '根目录'}}</button><button wx:if="{{currentFolder}}" class="link" bindtap="up">上一级</button></view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="reload" disabled="{{busy}}">刷新</button></view>
  <view wx:for="{{children}}" wx:key="id" class="folder row"><view class="grow" bindtap="enter" data-id="{{item.id}}">{{item.name}} ›</view><button class="link" bindtap="manage" data-id="{{item.id}}">管理</button></view>
  <view wx:if="{{managing}}" class="card section"><text class="section-title">管理文件夹</text><view class="field"><text class="label">名称</text><input class="input" value="{{folderName}}" bindinput="name" maxlength="100"/></view><view class="field"><text class="label">移动到</text><picker class="picker" range="{{parentLabels}}" value="{{parentIndex}}" bindchange="parent">{{parentLabels[parentIndex]}}</picker></view><view class="hint">下属文件会一起移动，稳定 ID 不变。</view><view class="buttons"><button bindtap="cancelManage" disabled="{{busy}}">取消</button><button class="primary" bindtap="saveFolder" disabled="{{busy}}">保存文件夹</button></view></view>
  <view class="section row"><text class="section-title">任务组 · {{total}}</text><label class="small"><switch checked="{{archive}}" bindchange="archive" color="#637f4d"/>已归档</label></view>
  <view wx:for="{{groups}}" wx:key="id" class="list-row" bindtap="open" data-id="{{item.id}}"><text class="file-title">{{item.title}}</text><view class="path">{{item.path}}</view><view class="meta"><text>{{item.progress.total ? item.progress.done + ' / ' + item.progress.total + ' 完成' : '无任务'}}</text><text class="badge">{{item.status === 'archived' ? '已归档' : item.status === 'done' ? '已完成' : '进行中'}}</text></view></view>
  <view wx:if="{{!groups.length &amp;&amp; !busy &amp;&amp; !error}}" class="empty"><text class="empty-title">为一件重要的事，建一个文件。</text>可以是一段资料，也可以是行动清单。</view>
  <view wx:if="{{total &gt; 30}}" class="buttons"><button bindtap="previous" disabled="{{busy || !offset}}">上一页</button><button bindtap="next" disabled="{{busy || offset + 30 &gt;= total}}">下一页</button></view>
</view>
