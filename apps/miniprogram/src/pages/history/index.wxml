<view class="page"><view class="kicker">HISTORY / 版本记录</view><view class="title">每次变更，都有来路。</view><view class="subtitle">撤销不删除历史。恢复旧内容，会生成新的修订号。</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:for="{{entries}}" wx:key="id" class="list-row"><text class="file-title">{{item.summary}}</text><view class="meta"><text>{{item.time_label}}</text><text>{{item.group_ids.length}} 个文件</text><text wx:if="{{item.undone_by}}" class="badge">已撤销</text></view><view class="buttons"><button bindtap="inspect" data-id="{{item.id}}" disabled="{{busy}}">查看差异</button><button bindtap="undo" data-id="{{item.id}}" disabled="{{busy || item.undone_by}}">撤销</button><button wx:if="{{item.restore_hash}}" bindtap="preview" data-hash="{{item.restore_hash}}" disabled="{{busy}}">预览恢复</button></view></view>
  <view wx:if="{{!entries.length &amp;&amp; !busy}}" class="empty">暂无版本记录。</view>
  <view wx:if="{{diff}}" class="section"><text class="section-title">{{preview ? '历史内容恢复预览' : '变更差异'}}</text><scroll-view class="diff" scroll-y><text selectable>{{diff}}</text></scroll-view><view wx:if="{{preview}}"><view class="notice">仅影响当前任务组。预览之后若发生新编辑，将要求重新确认。</view><button class="primary" bindtap="restore" disabled="{{busy}}">确认恢复为新版本</button><button bindtap="cancel" disabled="{{busy}}">取消恢复</button></view></view>
</view>
