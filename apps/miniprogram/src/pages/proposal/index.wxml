<view class="page"><view class="kicker">PROPOSAL / 确认提案</view><view class="title">由你做最后确认。</view><view class="subtitle">核对任务与归属。确认之前，不会写入业务文件。</view>
  <view wx:if="{{proposal}}"><view class="notice"><view>{{providerLabel}}</view><view>修订 {{proposal.revision}} · {{proposal.status}}</view><view>未明确的负责人和截止日期不自动补齐。</view></view><text class="raw" selectable>{{raw}}</text>
    <view class="notice">任务写在任务组内，不用任务内容命名文件。优先使用已有任务组；没有合适的，可在工作空间或文件夹下新建。无法判断主题时，默认放入「日常任务」。</view>
    <view wx:if="{{proposal.status === 'stale'}}" class="error">目标内容已变化。请更新预览，再确认最新差异。</view>
    <view wx:if="{{!readonly}}" class="section"><view class="field"><text class="label">查找追加目标</text><input class="input" value="{{targetInput}}" bindinput="targetInput" maxlength="200" placeholder="搜索全部可写任务组名称或路径" disabled="{{busy}}"/><button bindtap="searchTargets" disabled="{{busy}}">查找目标</button><view class="hint">翻页和搜索不会更改已选归属。共 {{targetTotal}} 个匹配目标。</view></view><view class="buttons"><button bindtap="previousTargets" disabled="{{busy || !targetOffset}}">上一页目标</button><button bindtap="nextTargets" disabled="{{busy || targetOffset + 20 &gt;= targetTotal}}">下一页目标</button></view></view>
    <view wx:for="{{actions}}" wx:key="action_id" wx:for-item="action" wx:for-index="actionIndex" class="card">
      <checkbox-group bindchange="select" data-id="{{action.action_id}}"><label class="checkbox-line"><checkbox value="yes" checked="{{selected[action.action_id]}}" disabled="{{readonly || busy}}" color="#486739"/><text class="action-title">{{action.tasks.length ? '行动 ' + (actionIndex + 1) : '保存为资料'}}</text></label></checkbox-group>
      <view wx:for="{{action.tasks}}" wx:for-item="task" wx:for-index="taskIndex" class="section">
        <view class="field"><text class="label">任务标题</text><input class="input" value="{{task.title}}" data-index="{{actionIndex}}" data-task="{{taskIndex}}" data-field="title" bindinput="taskInput" maxlength="200" disabled="{{readonly || busy}}"/></view>
        <view class="field"><text class="label">负责人</text><input class="input" value="{{task.owner || ''}}" data-index="{{actionIndex}}" data-task="{{taskIndex}}" data-field="owner" bindinput="taskInput" placeholder="未指定" disabled="{{readonly || busy}}"/></view>
        <view class="two-columns"><view class="field"><text class="label">计划日期</text><picker class="picker" mode="date" value="{{task.scheduled.date}}" data-index="{{actionIndex}}" data-task="{{taskIndex}}" data-field="scheduled" data-part="date" bindchange="time" disabled="{{readonly || busy}}">{{task.scheduled.date || '未设置'}}</picker></view><view class="field"><text class="label">计划时间</text><picker class="picker" mode="time" value="{{task.scheduled.time || '09:00'}}" data-index="{{actionIndex}}" data-task="{{taskIndex}}" data-field="scheduled" data-part="time" bindchange="time" disabled="{{readonly || busy || !task.scheduled}}">{{task.scheduled.time || '不指定'}}</picker></view></view>
        <view class="row"><picker range="{{periods}}" data-index="{{actionIndex}}" data-task="{{taskIndex}}" data-field="scheduled" data-part="period" bindchange="time" disabled="{{readonly || busy || !task.scheduled}}"><text class="small">计划时段：{{task.scheduled.period === 'afternoon' ? '下午' : task.scheduled.period === 'morning' ? '上午' : task.scheduled.period === 'evening' ? '晚上' : '不指定'}} ﹀</text></picker><button class="link" bindtap="clearTime" data-index="{{actionIndex}}" data-task="{{taskIndex}}" data-field="scheduled" disabled="{{readonly || busy}}">清除计划</button></view>
        <view class="two-columns"><view class="field"><text class="label">截止日期</text><picker class="picker" mode="date" value="{{task.deadline.date}}" data-index="{{actionIndex}}" data-task="{{taskIndex}}" data-field="deadline" data-part="date" bindchange="time" disabled="{{readonly || busy}}">{{task.deadline.date || '未设置'}}</picker></view><view class="field"><text class="label">截止时间</text><picker class="picker" mode="time" value="{{task.deadline.time || '18:00'}}" data-index="{{actionIndex}}" data-task="{{taskIndex}}" data-field="deadline" data-part="time" bindchange="time" disabled="{{readonly || busy || !task.deadline}}">{{task.deadline.time || '当天结束'}}</picker></view></view>
        <button class="link" bindtap="clearTime" data-index="{{actionIndex}}" data-task="{{taskIndex}}" data-field="deadline" disabled="{{readonly || busy}}">清除截止时间</button>
      </view>
      <view wx:if="{{!action.tasks.length}}" class="field section"><text class="label">资料正文</text><textarea class="textarea" value="{{action.body_append}}" data-index="{{actionIndex}}" data-field="body_append" bindinput="actionInput" maxlength="20000" disabled="{{readonly || busy}}"/></view>
      <view class="divider"/><view class="field"><text class="label">保存到哪里：所属任务组</text><picker class="picker" range="{{targetLabels}}" value="{{targetIndexes[action.action_id] || 0}}" bindchange="target" data-index="{{actionIndex}}" disabled="{{readonly || busy}}">{{targetLabels[targetIndexes[action.action_id] || 0]}} ﹀</picker></view>
      <view wx:if="{{action.type === 'create'}}"><view class="field"><text class="label">任务组名称</text><input class="input" value="{{action.group_title}}" data-index="{{actionIndex}}" data-field="group_title" bindinput="actionInput" disabled="{{readonly || busy}}"/><view class="hint">用主题命名，例如「合同跟进」，不要照抄任务标题。同一位置同名的可写任务组会复用。</view></view><view class="field"><text class="label">归属位置</text><picker class="picker" range="{{folderLabels}}" bindchange="folder" data-index="{{actionIndex}}" disabled="{{readonly || busy}}">{{folderNames[action.folder_id] || '工作空间根目录'}} ﹀</picker></view></view>
      <view class="confidence" wx:if="{{action.evidence.title}}"><view>标题依据：{{action.evidence.title}}</view><view>置信提示：{{action.field_confidence.title === 'high' ? '较高，仍需确认' : '请核对原意'}}</view><view wx:if="{{action.evidence.scheduled}}">计划依据：{{action.evidence.scheduled}}</view><view wx:if="{{action.evidence.deadline}}">截止依据：{{action.evidence.deadline}}</view></view>
    </view>
    <view wx:if="{{questions.length}}" class="section"><text class="section-title">需要留意</text><checkbox-group wx:for="{{questions}}" data-index="{{index}}" bindchange="question"><label class="checkbox-line"><checkbox value="yes" checked="{{item.resolved}}" disabled="{{readonly || busy}}" color="#486739"/><text>{{item.message}}（{{item.required ? '必需，处理后勾选' : '可选'}}）</text></label></checkbox-group></view>
    <view class="summary"><view>选中 {{selectedCount}} 项动作 · 新增 {{taskCount}} 项任务</view><view>{{hasPreview ? '影响 ' + fileCount + ' 个文件' : '更新预览后确认影响范围'}}</view><view class="hint">未选建议标为忽略，原文仍保留。高置信度也不会自动写入。</view></view>
    <view wx:if="{{error}}" class="error">{{error}}<button bindtap="reload" disabled="{{busy}}">重新读取提案</button></view>
    <view wx:if="{{!readonly}}"><button bindtap="preview" loading="{{busy}}" disabled="{{busy || !selectedCount}}">{{dirty || proposal.status === 'stale' ? '保存修订并更新预览' : '更新预览'}}</button><button class="primary" bindtap="apply" disabled="{{busy || dirty || !hasPreview || hasRequired || !selectedCount}}">确认写入</button><button class="link" bindtap="reject" disabled="{{busy}}">取消整个提案</button></view>
    <view wx:else class="notice">这份提案已结束。已写入的内容可从工作空间查看版本与撤销。</view>
    <view class="section"><text class="section-title">{{hasPreview ? '本次最终差异' : '建议差异（待更新预览）'}}</text><view wx:for="{{previews}}" wx:key="group_id"><text class="path">{{item.path}}</text><view wx:if="{{item.will_reopen}}" class="hint">此任务组将恢复为进行中。</view><scroll-view class="diff" scroll-y><text selectable>{{item.diff}}</text></scroll-view></view></view>
  </view><view wx:elif="{{error}}" class="error">{{error}}<button bindtap="reload">重新读取</button></view>
</view>
