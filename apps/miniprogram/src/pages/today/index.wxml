<view class="page"><view class="kicker">TODAY / 今日</view><view class="title">把注意力，留给下一步。</view><view class="subtitle">计划与截止分别管理。没有截止时间，不会被算作逾期。</view>
  <view class="tabs"><button wx:for="{{filters}}" wx:key="*this" class="{{index === filterIndex ? 'selected' : ''}}" data-index="{{index}}" bindtap="filter">{{item}}</button></view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="reload" disabled="{{busy}}">刷新</button></view>
  <view wx:if="{{filterIndex === 0 &amp;&amp; overdue.length}}" class="section"><text class="section-title danger-text">已逾期 · {{overdueTotal}}</text>
    <view wx:for="{{overdue}}" wx:key="id" class="task-row"><button class="task-check" bindtap="complete" data-id="{{item.id}}" disabled="{{busy}}"><view/></button><view class="grow" bindtap="open" data-id="{{item.id}}" data-group="{{item.group_id}}"><text class="task-title">{{item.title}}</text><view class="task-meta">{{item.group_title}}</view><view class="task-meta danger-text">截止 {{item.deadline_label}}</view></view><text class="badge">{{item.status_label}}</text></view>
  </view>
  <view class="section row"><text class="section-title">{{filters[filterIndex]}} · {{total}} 项</text><button wx:if="{{canUndo}}" class="link" bindtap="undo" disabled="{{busy}}">撤销最近变更</button></view>
  <view wx:for="{{tasks}}" wx:key="id" class="task-row"><button class="task-check" bindtap="complete" data-id="{{item.id}}" disabled="{{busy}}"><view>{{item.status === 'done' ? '✓' : ''}}</view></button><view class="grow" bindtap="open" data-id="{{item.id}}" data-group="{{item.group_id}}"><text class="task-title {{item.status === 'done' ? 'done' : ''}}">{{item.title}}</text><view class="task-meta">{{item.group_title}} {{item.owner || ''}}</view><view wx:if="{{item.scheduled}}" class="task-meta">计划 {{item.scheduled_label}}</view><view wx:if="{{item.deadline}}" class="task-meta {{item.is_overdue ? 'danger-text' : ''}}">截止 {{item.deadline_label}}</view></view><text class="badge {{item.status}}">{{item.status_label}}</text></view>
  <view wx:if="{{!tasks.length &amp;&amp; !busy &amp;&amp; !error}}" class="empty"><text class="empty-title">这里，还有留白。</text>整理一条记录，或为任务安排日期。<button bindtap="capture">记录一件事</button></view>
  <view wx:if="{{total &gt; 30}}" class="buttons"><button bindtap="previous" disabled="{{busy || !offset}}">上一页</button><button bindtap="next" disabled="{{busy || offset + 30 &gt;= total}}">下一页</button></view>
</view>
