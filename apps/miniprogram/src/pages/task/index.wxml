<view class="page"><view class="kicker">TASK / 行动</view><view class="title">{{isNew ? '写下明确的下一步。' : '让下一步，更清晰。'}}</view><view class="subtitle">{{groupTitle}}</view><view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{!ready}}" bindtap="reload" disabled="{{busy}}">重新读取</button></view>
  <view wx:if="{{ready}}"><view class="card"><view class="field"><text class="label">任务标题</text><input class="input" value="{{draft.title}}" bindinput="input" data-field="title" maxlength="200"/></view>
    <view class="two-columns"><view class="field"><text class="label">状态</text><picker class="picker" range="{{statusLabels}}" value="{{statusIndex}}" bindchange="status">{{statusLabels[statusIndex]}}</picker></view><view class="field"><text class="label">优先级</text><picker class="picker" range="{{priorities}}" value="{{priorityIndex}}" bindchange="priority">{{priorities[priorityIndex]}}</picker></view></view>
    <view class="field"><text class="label">负责人</text><input class="input" value="{{draft.owner || ''}}" bindinput="input" data-field="owner" maxlength="100" placeholder="未指定，不默认填我"/></view>
    <view class="field"><text class="label">标签（逗号分隔）</text><input class="input" value="{{tags}}" bindinput="tags"/></view></view>
    <view class="card"><text class="section-title">计划时间</text><view class="two-columns"><view class="field"><text class="label">日期</text><picker class="picker" mode="date" value="{{draft.scheduled.date}}" data-field="scheduled" data-part="date" bindchange="time">{{draft.scheduled.date || '未设置'}}</picker></view><view class="field"><text class="label">具体时间</text><picker class="picker" mode="time" value="{{draft.scheduled.time || '09:00'}}" data-field="scheduled" data-part="time" bindchange="time" disabled="{{!draft.scheduled}}">{{draft.scheduled.time || '不指定'}}</picker></view></view><view class="field"><text class="label">时段（与具体时间二选一）</text><picker class="picker" range="{{periods}}" value="{{periodIndex}}" data-field="scheduled" data-part="period" bindchange="time" disabled="{{!draft.scheduled}}">{{periods[periodIndex]}}</picker></view><view wx:if="{{draft.scheduled}}" class="hint">时区：{{draft.scheduled.timezone}}</view><button class="link" bindtap="clear" data-field="scheduled">清除计划时间</button></view>
    <view class="card"><text class="section-title">截止时间</text><view class="two-columns"><view class="field"><text class="label">日期</text><picker class="picker" mode="date" value="{{draft.deadline.date}}" data-field="deadline" data-part="date" bindchange="time">{{draft.deadline.date || '未设置'}}</picker></view><view class="field"><text class="label">具体时间</text><picker class="picker" mode="time" value="{{draft.deadline.time || '18:00'}}" data-field="deadline" data-part="time" bindchange="time" disabled="{{!draft.deadline}}">{{draft.deadline.time || '当天结束'}}</picker></view></view><view class="hint">只选日期时，当天结束后才算逾期。计划日期过期不会被当作截止逾期。</view><view wx:if="{{draft.deadline}}" class="hint">时区：{{draft.deadline.timezone}}</view><button class="link" bindtap="clear" data-field="deadline">清除截止时间</button></view>
    <view class="card"><view class="field"><text class="label">地点</text><input class="input" value="{{draft.location || ''}}" data-field="location" bindinput="input" maxlength="200"/></view><view class="field"><text class="label">情境</text><input class="input" value="{{draft.context || ''}}" data-field="context" bindinput="input" maxlength="200" placeholder="比如，需要电脑"/></view></view>
    <button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存任务</button>
    <view wx:if="{{sources.length}}" class="section"><text class="section-title">原始来源</text><button wx:for="{{sources}}" wx:key="*this" class="link" bindtap="original" data-id="{{item}}">查看原文 {{index + 1}}</button></view>
  </view>
</view>
